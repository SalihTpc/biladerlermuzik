# Active tenant (must match a key in lib/tenants/registry.json)
# Prefer per-tenant files under .env.tenants/ — see docs/TENANTS.md
#   cp .env.tenants/biladerler.env.example .env.tenants/biladerler.env
#   npm run tenant:use -- biladerler
NEXT_PUBLIC_TENANT_ID=biladerler

# Firebase (client — NEXT_PUBLIC_*) — per-tenant Firebase project
NEXT_PUBLIC_API_KEY=
NEXT_PUBLIC_AUTH_DOMAIN=
NEXT_PUBLIC_PROJECT_ID=
NEXT_PUBLIC_STORAGE_BUCKET=
NEXT_PUBLIC_MESSAGING_SENDER_ID=
NEXT_PUBLIC_APP_ID=

# Public site URL (SEO: canonical, Open Graph, sitemap) — no trailing slash
# NEXT_PUBLIC_SITE_URL=https://www.example.com
